# ─────────────────────────────────────────────────────────────────────────────
# Endcard backend environment. Copy to `.env` and fill in. NEVER commit `.env`.
# Generate the two crypto secrets with:  npm run gen:keys -w @endcard/backend
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=4000

# Comma-separated list of origins allowed to call this API (the Expo app).
# Leave as-is for local dev; lock down for production.
CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# ── Supabase ────────────────────────────────────────────────────────────────
# Project Settings → API. The service-role key is a SECRET; backend only.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Project Settings → API → JWT Settings → "JWT Secret".
# Used to mint app session JWTs that Supabase RLS will trust.
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# ── Endcard crypto ──────────────────────────────────────────────────────────
# 32-byte base64 key for AES-256-GCM encryption of platform refresh tokens
# at rest. Rotate by re-keying; never reuse across environments.
TOKEN_ENC_KEY=generate-with-gen:keys

# How long an encrypted platform refresh token may live before forced reconnect.
TOKEN_TTL_MINUTES=43200

# ── AI commentary (optional) ────────────────────────────────────────────────
# Set ONE provider's key to enable AI commentary. With neither, the app shows
# the free rule-based persona and skips commentary (no errors).
#
# Groq (recommended: free, no card, doesn't train on inputs). Key from
# console.groq.com → API Keys. Starts with gsk_...
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile
#
# Anthropic / Claude (needs prepaid credits). Key from console.anthropic.com.
# ANTHROPIC_API_KEY=
#
# If both keys are set, choose with: AI_PROVIDER=groq | anthropic
# AI_PROVIDER=groq

# ── TestFlight Pro testing ───────────────────────────────────────────────────
# Lets /pro/activate grant Pro on a production backend so testers can try Pro
# before real in-app purchases exist. MUST be false/unset for a paid launch.
# ALLOW_DEV_PRO=true
